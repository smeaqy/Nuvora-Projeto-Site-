# =============================================================================
# BrasilTec Educação — configuração de ambiente
# =============================================================================
# Copie este arquivo para `.env` e ajuste os valores.
# NUNCA faça commit do `.env` real.
# =============================================================================

# Aplicação
APP_ENV=development
PORT=4173
APP_URL=http://localhost:4173
APP_NAME=BrasilTec Educação

# Banco de dados SQLite (caminho relativo à raiz do projeto)
DB_PATH=data/brasiltec.db

# Banco remoto libSQL/Turso — obrigatório na Vercel (serverless).
# Crie em https://turso.tech e cole a URL e o token.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Em produção sem Turso a aplicação falha de propósito. Use 1 apenas para
# aceitar SQLite efêmero (os dados são perdidos a cada cold start).
ALLOW_LOCAL_DB=0

# Demonstração: exibe a faixa de ambiente demonstrativo e os acessos rápidos
# na tela de login. Em produção, use DEMO_MODE=0.
DEMO_MODE=1

# Conta administradora criada no primeiro start (somente se o banco estiver vazio).
# Defina antes do primeiro deploy; depois a senha pode ser trocada no painel.
ADMIN_NAME=Administração BrasilTec
ADMIN_EMAIL=admin@brasiltec.demo
ADMIN_PASSWORD=Admin@2026

# E-mail transacional (opcional). Sem chave, os e-mails não são enviados e o
# link de redefinição aparece apenas no modo de demonstração.
RESEND_API_KEY=
MAIL_FROM=BrasilTec Educação <no-reply@brasilteceducacao.com.br>
SUPPORT_EMAIL=

# Pagamentos — Mercado Pago Checkout Pro (opcional).
# Sem credenciais, pedidos pagos ficam pendentes para aprovação administrativa.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_PUBLIC_KEY=

# Segurança
# Em produção (HTTPS), defina COOKIE_SECURE=1.
COOKIE_SECURE=0
# Limite de tentativas de login por IP + e-mail na janela (minutos).
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_MINUTES=15
